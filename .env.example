NODE_ENV=development
HOST=0.0.0.0
PORT=3210
APP_BASE_URL=http://localhost:3210
SESSION_COOKIE_SECURE=false
# Neon PostgreSQL connection string in production; leave blank for local SQLite.
DATABASE_URL=
SESSION_DATABASE_PATH=
# Set only after the PostgreSQL schema has been initialized and verified.
SKIP_DATABASE_INIT=false
# Production registration fails closed unless an access code or allowed domain is configured.
REGISTRATION_ACCESS_CODE=
REGISTRATION_ALLOWED_DOMAINS=
SESSION_SECRET=replace-with-at-least-32-random-characters
# 64 hex characters (32 bytes)
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Optional: keep the app on a private LAN and use an HTTPS deployment only as an OAuth relay.
GOOGLE_RELAY_URL=
GOOGLE_RELAY_SECRET=
# Server-only. Never expose this through HTML, browser JavaScript, NEXT_PUBLIC_, or VITE_ variables.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Server-only multilingual semantic recall for cannibalization detection.
OPENAI_EMBEDDING_ENABLED=true
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_FALLBACK_MODELS=
# bge-m3 and multilingual-e5-large both use 1024 dimensions.
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_EMBEDDING_TIMEOUT_MS=45000
# responses or chat; choose the protocol supported by the relay and model.
OPENAI_API_MODE=responses
ENABLE_DEMO_ACCOUNT=true
